# SSH Config File
# This file contains configuration for SSH connections

# GitHub Configuration
Host github
  HostName github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
  User git
  ForwardAgent yes

# Default settings for all hosts
Host *
  # Automatically add new keys to the SSH agent
  AddKeysToAgent yes

  # Use the local SSH keychain
  UseKeychain yes

  # Forward the authentication agent connection
  ForwardAgent no

  # Attempt to keep the connection alive with the server
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Specify the default identity file to be used
  IdentityFile ~/.ssh/id_rsa

  # Enable faster connection setup by skipping DNS lookups
  UseDNS no

  # Set default preferred authentication methods
  PreferredAuthentications publickey,keyboard-interactive

  # Control TCP keepalives to prevent disconnection
  TCPKeepAlive yes

  # Verify host key (useful for known_hosts management)
  StrictHostKeyChecking ask

# Add additional hosts below
