# == SSH client config ==
# Deployed to ~/.ssh/config (mode 600). Only this file is managed — keys are
# never committed or symlinked. UseKeychain is macOS-only, so it's guarded with
# IgnoreUnknown to stay portable across Linux/work boxes (D2).

IgnoreUnknown UseKeychain

# Profile-specific Host entries (github-personal, github-work, etc.) live in
# ~/.ssh/config.d/*.conf and are dropped in by the ssh-personal / ssh-work
# Stow overlays. ssh matches the FIRST `Host` block per attribute, so this
# Include is at the top — overlay hosts can override anything below.
Include ~/.ssh/config.d/*.conf

# --- Defaults for all hosts ---
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

  # No agent forwarding by default — opt in per-host only when a remote needs it.
  ForwardAgent no

  # Keep idle connections alive (3 missed 60s probes = drop).
  ServerAliveInterval 60
  ServerAliveCountMax 3

  UseDNS no
  PreferredAuthentications publickey,keyboard-interactive
  TCPKeepAlive yes

  # Prompt before trusting an unknown host key (never auto-accept).
  StrictHostKeyChecking ask

# Add additional hosts below. Example:
# Host myserver
#   HostName myserver.example.com
#   User myuser
#   IdentityFile ~/.ssh/my_custom_key
