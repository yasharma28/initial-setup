# Machine-local override (always loaded if present). Use for one-off
# machine-specific tweaks. Never committed — create per machine.
[include]
    path = ~/.gitconfig.local

# Default identity (personal). Per-tree overrides below pick the right
# signing key + sshCommand based on which Documents/ subtree the repo is in.
[user]
    name = Yash Sharma
    email = yasharma28@gmail.com
    username = yasharma28

# Personal repos under ~/Documents/personal/ — file provided by the
# `git-personal` Stow overlay (make setup PROFILE=personal).
[includeIf "gitdir:~/Documents/personal/"]
    path = ~/.gitconfig_personal

# Work repos under ~/Documents/work/ — file provided by the
# `git-work` Stow overlay (make setup PROFILE=work).
[includeIf "gitdir:~/Documents/work/"]
    path = ~/.gitconfig_work

[init]
    defaultBranch = main

[core]
    editor = nvim
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    pager = less
    excludesFile = ${HOME}/.gitignore

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    lg = log --graph --oneline --decorate --all
    last = log -1 HEAD
    amend = commit --amend --no-edit
    save = "!git add -A && git commit -m 'WIP'"
    unstage = reset HEAD --
    # Bulk-delete every local branch except main/master and the current one.
    # Useful after merging a batch of PRs; -D so it works for un-pushed work too.
    cb = "!git branch | grep -v -E \"^\\\\*|main|master\" | xargs git branch -D"
    # Soft-undo the last commit, keeping its changes staged. Pairs with `amend`.
    uncommit = reset --soft HEAD^
    # Nuclear: discard ALL working-tree changes + untracked files. Use with care.
    undo = "!git reset --hard HEAD && git clean -fd"

[diff]
    tool = nvimdiff

[merge]
    tool = nvimdiff

[mergetool]
    prompt = false

[web]
    browser = firefox

[push]
    default = current

[credential]
    # macOS Keychain — no plaintext ~/.git-credentials. On Linux, override in
    # ~/.gitconfig.local with e.g. `helper = cache --timeout=3600` or libsecret.
    helper = osxkeychain

# Per-host credential helpers: route github.com + gist.github.com through
# `gh auth git-credential` so OAuth tokens (with PAT scopes) are reused
# automatically. Empty `helper =` line first CLEARS any inherited helper for
# that host, so only `gh auth` answers. This matches what `gh auth setup-git`
# would write, made portable: brew installs gh at $HOMEBREW_PREFIX/bin/gh,
# which is on PATH for any interactive shell. On Linux without brew, change
# the path or remove these blocks in ~/.gitconfig.local.
[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential

[rebase]
    autosquash = true

[color]
    ui = auto

[log]
    decorate = short

[status]
    short = true
    branch = true

[fetch]
    prune = true

[pull]
    rebase = true

[commit]
    template = ${HOME}/.gitmessage.txt

[rerere]
    enabled = true
