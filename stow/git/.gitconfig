# Machine-local overrides (work identity, OS-specific credential helper, etc.).
# Loaded first so anything below is a default the local file can override.
# This file is never committed — create it per machine.
[include]
    path = ~/.gitconfig.local

[user]
    name = Yash Sharma
    email = yasharma28@gmail.com
    username = yasharma28

# Work repos get a different identity. Adjust the gitdir to where you keep work
# checkouts; ~/.gitconfig-work holds the work name/email and is NOT committed.
[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work

[init]
    defaultBranch = main

[core]
    editor = nvim
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    pager = less
    excludesFile = ${HOME}/.gitignore

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    lg = log --graph --oneline --decorate --all
    last = log -1 HEAD
    amend = commit --amend --no-edit
    save = "!git add -A && git commit -m 'WIP'"
    unstage = reset HEAD --

[diff]
    tool = nvimdiff

[merge]
    tool = nvimdiff

[mergetool]
    prompt = false

[web]
    browser = firefox

[push]
    default = current

[credential]
    # macOS Keychain — no plaintext ~/.git-credentials. On Linux, override in
    # ~/.gitconfig.local with e.g. `helper = cache --timeout=3600` or libsecret.
    helper = osxkeychain

[rebase]
    autosquash = true

[color]
    ui = auto

[log]
    decorate = short

[status]
    short = true
    branch = true

[fetch]
    prune = true

[pull]
    rebase = true

[commit]
    template = ${HOME}/.gitmessage.txt

[rerere]
    enabled = true
