# Global gitignore — deployed to ~/.gitignore (git core.excludesFile). User-level
# OS/editor junk only; per-repo artifacts belong in each repo's own .gitignore.
.DS_Store
ehthumbs.db
Thumbs.db
Icon?

*~
*.swp
*.swo

.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# AI coding assistants — per-repo session/transcript/agent data, never code.
# Anthropic Claude Code drops .claude/ in every repo it operates on; aider
# uses .aider.* tags. Both belong in user-level ignore so no repo has to
# remember to add them.
.claude/
.aider*
