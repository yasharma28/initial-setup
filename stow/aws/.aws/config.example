# == AWS config (SSO) ==
# Deployed to ~/.aws/config. Models the SSO + role-assumption workflow used by
# the aws-sso / assume shell helpers — NOT static access keys. There is no
# credentials file in this repo: SSO issues short-lived creds on `aws sso login`
# (see .gitignore, which blocks any real credentials from being committed).
#
# Fill in the placeholders below per machine, then: aws sso login --profile <name>

[default]
region = us-east-1
output = json

# --- SSO session (shared by all SSO profiles) ---
; [sso-session my-sso]
; sso_start_url = https://<your-org>.awsapps.com/start
; sso_region = us-east-1
; sso_registration_scopes = sso:account:access

# --- SSO profile (one block per account/role you assume) ---
; [profile <profile-name>]
; sso_session = my-sso
; sso_account_id = <account-id>
; sso_role_name = <permission-set-name>
; region = us-east-1
; output = json

# --- Role chaining from an SSO profile (optional) ---
; [profile <assumed-role>]
; role_arn = arn:aws:iam::<account-id>:role/<role-name>
; source_profile = <profile-name>
