# == Brewfile ==
# Homebrew packages for a fresh machine, installed via `brew bundle`.
# The terminal stack is grouped first; GUI apps and VS Code extensions follow.

tap "homebrew/bundle"
tap "null-dev/firefox-profile-switcher"

# --- Terminal stack ---
# Prompt migrated off powerlevel10k -> starship. fzf+zoxide feed the sesh picker.
brew "coreutils"
brew "fzf"               # fuzzy finder — sesh picker, Ctrl-R history, Ctrl-T files
brew "neovim"
brew "sesh"              # tmux session manager / project switcher
brew "starship"          # prompt (replaces powerlevel10k)
brew "tmux"
brew "tree-sitter-cli"   # compiles nvim treesitter parsers (main branch needs it)
brew "zoxide"            # smart dir jumping; records dirs to seed sesh

brew "null-dev/firefox-profile-switcher/firefox-profile-switcher-connector"

# --- Fonts ---
# Complete Meslo Nerd Font. Set iTerm's profile font to "MesloLGS Nerd Font Mono"
# (NOT the minimal "MesloLGS NF" — it lacks the glyphs which-key/Starship use).
cask "font-meslo-lg-nerd-font"

# --- GUI apps ---
cask "1password"
cask "authy"
cask "balenaetcher"
cask "discord"
cask "docker"
cask "firefox"
cask "iina"
cask "microsoft-auto-update"
cask "microsoft-office"
cask "rectangle"
cask "visual-studio-code"
cask "whatsapp"
cask "zoom"

# --- VS Code extensions ---
vscode "dbaeumer.vscode-eslint"
vscode "esbenp.prettier-vscode"
vscode "github.vscode-github-actions"
vscode "hashicorp.terraform"
vscode "ms-azuretools.vscode-docker"
vscode "ms-python.isort"
vscode "ms-python.python"
vscode "ms-vscode.cmake-tools"
vscode "ms-vscode.cpptools"
vscode "ms-vscode.cpptools-extension-pack"
vscode "ms-vscode.cpptools-themes"
vscode "ms-vscode.makefile-tools"
vscode "ms-vscode.vscode-typescript-next"
vscode "ms-vsliveshare.vsliveshare"
vscode "redhat.vscode-yaml"
vscode "streetsidesoftware.code-spell-checker"
vscode "twxs.cmake"
