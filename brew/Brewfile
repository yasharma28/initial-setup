brew "hashicorp/tap/hcp"
brew "hashicorp/tap/packer"
brew "hashicorp/tap/terraform"
brew "hashicorp/tap/terraform-ls"
brew "hashicorp/tap/vault"

# --- Containers ---
# docker (formula) ships only the CLI; docker-desktop (cask) provides the engine.
# link:false avoids fighting Docker Desktop for the /usr/local symlink on Intel.
brew "docker", link: false
brew "docker-compose"
cask "docker-desktop"

# --- Backends / databases ---
brew "liquibase"
brew "mongosh"
brew "mongodb/brew/mongodb-database-tools"
brew "redis"
brew "supabase/tap/supabase"
brew "libpq", link: true # provides psql; link:true so it's on PATH
brew "tbls"              # schema docs generator

# --- Networking ---
brew "tailscale"
cask "tailscale-app"

# --- Cloud SDKs ---
cask "gcloud-cli"        # was `google-cloud-sdk`; current cask is gcloud-cli
cask "session-manager-plugin"
cask "warrensbox/tap/tfswitch"

# --- Fonts ---
# Complete Meslo Nerd Font. Set iTerm's profile font to "MesloLGS Nerd Font Mono"
# (NOT the minimal "MesloLGS NF" — it lacks the glyphs which-key/Starship use).
cask "font-meslo-lg-nerd-font"

# --- Dev apps ---
cask "rectangle"
cask "visual-studio-code"

