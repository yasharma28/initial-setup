# == Brewfile (core) ==
# Always-installed base for any dev machine (work or personal): terminal stack,
# language toolchains, DevOps CLIs, container runtimes, fonts, IDEs, VS Code
# extensions. Profile-specific extras (comms apps, personal browsers, photo
# tools) live in Brewfile.personal / Brewfile.work and are layered on via
# `make mac_setup PROFILE=personal|work`.
#
# Formulae are intentionally unpinned — latest is desired for dev tooling
# (see the hermetic exception in plan.md).

tap "hashicorp/tap"
tap "homebrew/bundle"
tap "mongodb/brew"
tap "oven-sh/bun"
tap "supabase/tap"
tap "warrensbox/tap"

# --- Terminal stack ---
brew "coreutils"
brew "fzf"               # fuzzy finder — sesh picker, Ctrl-R history, Ctrl-T files
brew "neovim"
brew "sesh"              # tmux session manager / project switcher
brew "starship"          # prompt
brew "stow"              # GNU Stow — symlinks the per-tool dotfile packages
brew "tmux"
brew "tree-sitter-cli"   # compiles nvim treesitter parsers (main branch needs it)
brew "vim"
brew "zoxide"            # smart dir jumping; records dirs to seed sesh
brew "powerlevel10k"     # zsh prompt (kept for parity with previous setups)

# --- Shell / general CLI ---
brew "direnv"
brew "gh"
brew "gnupg"
brew "pinentry-mac"      # GPG passphrase prompt that works under macOS
brew "jq"
brew "yq"
brew "ripgrep"           # rg; RIPGREP_CONFIG_PATH in .zshrc
brew "tree"
brew "parallel"
brew "pandoc"
brew "pre-commit"
brew "shellcheck"
brew "bats-core"         # bash test framework
brew "bfg"               # repo history rewriter
brew "mise"              # polyglot runtime version manager

# --- Language toolchains ---
brew "go"
brew "gopls"
brew "rust"
brew "rust-analyzer"
brew "pyenv"
brew "pyright"
brew "uv"                # fast Python package/proj manager
brew "pnpm"
brew "oven-sh/bun/bun"
brew "dotnet"
brew "powershell"
brew "lua-language-server"
brew "bazel"
brew "buf"               # protobuf workflows
brew "protobuf"
brew "go-task"           # taskfile.dev runner

# --- DevOps / cloud CLIs (the shell config in stow/zsh/.zshrc assumes these) ---
brew "awscli"
brew "azure-cli"
brew "argocd"
brew "helm"
brew "infracost"
brew "krew"              # kubectl plugin manager (KREW_ROOT in .zshrc)
brew "kube-linter"
brew "kubeconform"
brew "kubectx"           # provides kubectx + kubens
brew "kubernetes-cli"    # kubectl
brew "minikube"
brew "tflint"
brew "tilt"
brew "terraform-docs"
brew "trivy"
