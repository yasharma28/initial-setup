# Ignore compiled source files #
###############################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Ignore temporary files #
##########################
*~
*.swp
*.swo

# Ignore package files #
########################
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Ignore logs #
###############
*.log

# Ignore OS generated files #
##############################
.DS_Store
ehthumbs.db
Icon?
Thumbs.db

# Ignore editor-specific files and directories #
###############################################
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore build and dependency directories #
###########################################
node_modules/
bower_components/
dist/
build/
out/

# Ignore environment-specific files #
#####################################
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Ignore miscellaneous files #
##############################
*.bak
*.tmp
*.old
