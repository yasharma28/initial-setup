# Ignore compiled source files #
###############################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Ignore temporary files #
##########################
*~
*.swp
*.swo

# Ignore package files #
########################
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Ignore logs #
###############
*.log

# Ignore OS generated files #
##############################
.DS_Store
ehthumbs.db
Icon?
Thumbs.db

# Ignore editor-specific files and directories #
###############################################
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore build and dependency directories #
###########################################
node_modules/
bower_components/
dist/
build/
out/

# Ignore environment-specific files #
#####################################
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Ignore miscellaneous files #
##############################
*.bak
*.tmp
*.old

# Never commit real secrets or credentials #
############################################
**/credentials
aws/credentials
.secrets*
*.secret
secrets.sh
# brew bundle dump snapshot (scratch; reconcile into the curated Brewfiles)
brew/Brewfile.dump

# Real AWS config carries workplace identifiers (SSO start URL, account IDs,
# profile names) and is per-machine. The aws-personal / aws-work overlay
# directories are stow-managed locally but never committed; only the public
# template (stow/aws/.aws/config.example) lives in git. Transport between
# machines is manual (scp the file once).
stow/aws-personal/.aws/config
stow/aws-work/.aws/config
